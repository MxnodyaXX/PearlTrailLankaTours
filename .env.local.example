# ── Supabase ────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in the values from your
# Supabase project:  Project Settings → API Keys (+ Project URL).
#
# Project URL (Settings → General, or https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# "Publishable key" (sb_publishable_...) — safe in the browser, RLS-protected.
# (Older projects call this the "anon public" key.)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# "Secret key" (sb_secret_...) — SERVER-ONLY. Never commit, never expose.
# (Older projects call this the "service_role" key.) Used by the seed script + admin writes.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx
